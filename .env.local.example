# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ===== VITE/CLIENT VARIABLES =====
# These are accessible in the browser (prefixed with VITE_)

# reCAPTCHA v3 Site Key (get from https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Supabase Configuration (usually comes with Supabase setup)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===== SUPABASE EDGE FUNCTIONS (SECRET) =====
# These variables are used by Supabase Edge Functions
# Set these in Supabase Dashboard → Project Settings → Functions → Environment Variables

# reCAPTCHA Secret Key (keep this SECRET - never expose to frontend)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Email Service Configuration
# Choose your email provider and configure accordingly:

# === SendGrid Option ===
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_SERVICE_URL=https://api.sendgrid.com/v3/mail/send

# === Mailgun Option ===
# MAILGUN_API_KEY=your_mailgun_api_key
# EMAIL_SERVICE_URL=https://api.mailgun.net/v3/your-domain/messages

# === Custom Email Service ===
EMAIL_SERVICE_URL=https://api.your-email-service.com/send
EMAIL_SERVICE_KEY=your_email_service_api_key

# ===== OPTIONAL: CRON JOB SERVICE =====
# If using Upstash or similar for scheduling

UPSTASH_REDIS_URL=your_upstash_redis_url
UPSTASH_REDIS_TOKEN=your_upstash_redis_token

# ===== NOTES =====
# 1. VITE_ prefixed variables are exposed to the browser - safe for public keys only
# 2. Non-prefixed variables are SECRET and must be set in Supabase securely
# 3. Never commit .env.local to version control
# 4. Never expose secret keys in frontend code
# 5. Use Supabase's built-in secrets manager for sensitive values
